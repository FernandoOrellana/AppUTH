<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".Views.ActivityPersonas">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/nombresTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:hint="@string/Nombre"
                android:inputType="text"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <EditText
                android:id="@+id/ApellidoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:hint="@string/Apellido"
                android:inputType="text"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <EditText
                android:id="@+id/FechaNacimientoTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:hint="@string/FechaNacimient"
                android:inputType="text"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <EditText
                android:id="@+id/DireccionTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:hint="@string/Direccion"
                android:inputType="text"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <EditText
                android:id="@+id/TelefonoTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:ems="10"
                android:hint="@string/Telefono"
                android:inputType="number"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <EditText
                android:id="@+id/CorreTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:ems="10"
                android:hint="@string/Correo"
                android:inputType="text|textEmailAddress"
                android:padding="12dp"
                android:textColorHint="#8B8B8B" />

            <Button
                android:id="@+id/buttonAgregar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#4A6FD7"
                android:padding="14dp"
                android:text="@string/AgregarPersona"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>